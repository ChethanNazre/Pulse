# Live data providers. Add credentials to .env.local; the browser never receives them.
# Keys are read ONLY in server-side route handlers (src/app/api) and never reach the browser.
NEWS_API_KEY=
TMDB_API_KEY=

# Keep false for real content only. Set true only when you explicitly want demo samples.
USE_SAMPLE_DATA=false

# Required before launch (checked by `npm run launch-check`).
# Your production domain, including https://
NEXT_PUBLIC_SITE_URL=
# Your name or business name, shown in the privacy policy and terms.
NEXT_PUBLIC_SITE_OPERATOR=
# A monitored address for privacy and legal requests.
NEXT_PUBLIC_CONTACT_EMAIL=
